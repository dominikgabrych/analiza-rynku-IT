POSTGRES_PASSWORD=change-me
RADAR_READER_PASSWORD=change-me

# radar backup: where the backups go and how many recent ones to keep
BACKUP_DIR=/path/to/backups
BACKUP_KEEP=3
# age public key (age1...) that encrypts the off-site copy
BACKUP_AGE_RECIPIENT=
BACKUP_OFFSITE_WARN_MB=1024
# How long a scheduled backup waits for the database to start
BACKUP_WAIT_SECONDS=300
